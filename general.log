		24182 Query	select w.*,q.nommodopago 			from( 				select 	a.socio, 					a.nomsocio, 					a.direccion, 					a.tel1, 					a.nivel,					 					a.tel2, 					a.correo, 					a.obs, 					a.activo, 					a.foto, 					a.modopago, 					a.importepago, 					a.descpo, 					a.becado, 					a.diapago, 					a.visitasdisp, 					a.fecvencevis, 					a.cumplea単os, 					a.sexo, 					a.clases, 					a.usunvo, 					a.fecnvo, 					a.usumod, 					a.fecmod, 					a.envia, 					a.campo1, 					a.campo2,	 					a.campo3,	 					a.campo4, 					a.campo5, 					a.campo6, 					a.campo7, 					a.campo8, 					a.campo9, 					a.campo10,					 					a.visvig, 					a.vissucacc, 					a.razonsocial, 					a.fcalle, 					a.fnumero, 					a.finterior, 					a.fcolonia, 					a.fciudad, 					a.festado, 					a.fcp, 					a.rfc, 					zzz.saldo 				from tbsocios a 					left join ( 							select xyz.socio,(sum(xyz.mensualidades) + sum(xyz.tickets)) as saldo 							from 	( 									select xx.socio,sum(xx.saldo) as mensualidades,0 as tickets 									from tbmensualidades xx 									where xx.cancelado=0 and xx.saldo>0	 									group by xx.socio 									union  									select yy.socio,0 as mensualidades,sum(yy.saldo) as tickets 									from tbtickets yy 									where yy.cancelado=0 and yy.saldo>0 									group by yy.socio  							) as xyz group by socio 					 					) zzz 					on a.socio=zzz.socio 				where a.activo=1			 				) as w 			left join tbmodospago as q 				on w.modopago=q.modopago
